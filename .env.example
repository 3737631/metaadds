# ============================================================
# META WINNERS — VARIABLES DE ENTORNO
# Copia este archivo a `.env.local` para desarrollo local y
# define las mismas claves (con valores reales) en Vercel
# (Project > Settings > Environment Variables).
#
# NUNCA pongas valores reales en este archivo. `.env*` está
# en `.gitignore`, pero trata estas claves como secretos.
# ============================================================

# --- META AD LIBRARY (búsqueda de ganadores) ---
# Token de acceso a la API oficial de Meta (Ads Library).
# Requiere verificación de identidad previa en facebook.com/ID.
# Se obtiene en developers.facebook.com/tools/explorer.
META_ADS_ACCESS_TOKEN=
# País a ingerir (ISO 3166-1 alpha-2). Por defecto ES (España).
META_ADS_COUNTRY=ES
# Credenciales de la app de Meta (opcional, para tokens de sistema).
META_ACCESS_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- IA: MULTIPROVEEDOR (estas llamadas ocurren SOLO en servidor) ---
# OpenRouter (proveedor principal).
OPENROUTER_API_KEY=
# Gemini (proveedor para tareas visuales/imagen).
GEMINI_API_KEY=
# OpenAI (proveedor de respaldo).
OPENAI_API_KEY=

# --- SUPABASE (base de datos + storage) ---
# URL del proyecto Supabase (https://xxxx.supabase.co).
SUPABASE_URL=
# Clave anon/publishable (segura para el cliente, con RLS activa).
SUPABASE_PUBLISHABLE_KEY=
# Clave de servicio (SOLO servidor: crea tus propios tokens en Supabase,
# no uses la service_role nativa en producción si es evitable).
SUPABASE_SECRET_KEY=

# --- BÚSQUEDA WEB (búsqueda real de tiendas/competidores) ---
# Clave de Serper (https://serper.dev, búsqueda de Google).
# OBLIGATORIA para usar Serper. Si no se define, se usa DuckDuckGo
# (gratis, sin clave, resultados algo peores). La IA NUNCA inventa tiendas.
SEARCH_API_KEY=

# --- SHOPIFY (creación de tienda, exportación de temas) ---
# App de Shopify: client id/secret y dominio público de la tienda.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP=
